<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.panalsuitemobile.ui.LoginFragment"
        android:label="Login">
        <action
            android:id="@+id/action_login_to_bandeja"
            app:destination="@id/bandejaFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/bandejaFragment"
        android:name="com.example.panalsuitemobile.ui.BandejaFragment"
        android:label="Bandeja">
        <action
            android:id="@+id/action_bandeja_to_login"
            app:destination="@id/loginFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_bandeja_to_detalle"
            app:destination="@id/detalleFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/detalleFragment"
        android:name="com.example.panalsuitemobile.ui.DetalleFragment"
        android:label="Detalle" />

</navigation>